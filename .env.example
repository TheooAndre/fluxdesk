# Default API bind is 127.0.0.1:8787, safe for personal local use.
HOST=127.0.0.1
PORT=8787
DATA_DIR=data
# For remote deployments ONLY: put API behind an OIDC authenticating reverse proxy.
# Do NOT set this true without a functioning proxy that blocks unauthenticated access.
REVERSE_PROXY_OIDC=false
# Generate with `npx web-push generate-vapid-keys` and set VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
