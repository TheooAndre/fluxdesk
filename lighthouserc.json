{
  "ci": {
    "collect": {
      "numberOfRuns": 2,
      "settings": {},
      "url": [
        "http://127.0.0.1:4179/",
        "http://127.0.0.1:4179/offline.html"
      ],
      "startServerCommand": "node scripts/lighthouse-server.mjs",
      "startServerReadyPattern": "Lighthouse fixture ready",
      "startServerReadyTimeout": 15000
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-report"
    }
  }
}
