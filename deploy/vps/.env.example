# Copy to deploy/vps/.env on the HOST only (chmod 600).
# Do NOT commit the filled file, paste secrets into chat, or prefix with VITE_.
# Enter only the DNS hostname, without https://
FLUXDESK_BACKEND_DOMAIN=api.your-domain.example
# Generate with: openssl rand -hex 32
# Use the exact same value in Vercel's server-only FLUXDESK_GATEWAY_TOKEN.
FLUXDESK_GATEWAY_TOKEN=SET_ME
# OCI only: must match /srv/fluxdesk/data/.fluxdesk-volume-id on the attached disk.
# Generate ON the disk using /proc/sys/kernel/random/uuid. Never use SET_ME live.
FLUXDESK_DATA_VOLUME_ID=SET_ME
