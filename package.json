{
  "name": "fluxdesk",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:api\" \"vite --host 127.0.0.1\"",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "e2e": "playwright test",
    "smoke": "node --experimental-strip-types --test tests/smoke.node.mjs",
    "test:smoke": "node --experimental-strip-types --test tests/smoke.node.mjs",
    "lighthouse": "lhci autorun",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "verify:feeds": "node --env-file-if-exists=.env --import tsx scripts/verify-feeds.ts",
    "research": "node --env-file-if-exists=.env --import tsx scripts/research-cli.ts",
    "archive": "node --import tsx scripts/archive-cli.ts",
    "release:preflight": "node --experimental-strip-types scripts/release-preflight.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.2",
    "lightweight-charts": "5.2.1",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.20.6",
    "web-push": "3.6.7",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.8",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "concurrently": "9.2.5",
    "eslint": "9.38.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "postcss": "8.5.31",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "6.4.5",
    "vite-plugin-pwa": "1.1.0",
    "vitest": "5.0.5",
    "workbox-background-sync": "7.3.0",
    "workbox-cacheable-response": "7.3.0",
    "workbox-core": "7.3.0",
    "workbox-expiration": "7.3.0",
    "workbox-precaching": "7.3.0",
    "workbox-routing": "7.3.0",
    "workbox-strategies": "7.3.0",
    "workbox-window": "7.3.0"
  }
}
